{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Expo Dev Server (QR / LAN)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start"],
      "port": 8081
    },
    {
      "name": "Expo Android Emulator",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--android"],
      "port": 8081
    },
    {
      "name": "Expo iOS Simulator",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--ios"],
      "port": 8081
    },
    {
      "name": "Expo Web (Browser)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web"],
      "port": 8081
    },
    {
      "name": "architecture",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-p", "3334", "-s", "."],
      "port": 3334
    }
  ]
}
