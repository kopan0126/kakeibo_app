        "ascAppId": "6775499989",
        "appleTeamId": "A5DFS7KCN2"
      }
    },
    "production": {
      "ios": {
        "appleId": "moriya.ryoga@gmail.com",
        "ascAppId": "6775499989",
        "appleTeamId": "A5DFS7KCN2"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
